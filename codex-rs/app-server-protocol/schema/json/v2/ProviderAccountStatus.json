{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProviderBalance": {
      "properties": {
        "amount": {
          "description": "Decimal amount as reported by the provider, without floating-point arithmetic.",
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "resetsAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "label"
      ],
      "type": "object"
    },
    "ProviderUsageWindow": {
      "properties": {
        "label": {
          "type": "string"
        },
        "remainingPercent": {
          "format": "double",
          "type": "number"
        },
        "resetsAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "remainingPercent"
      ],
      "type": "object"
    }
  },
  "description": "Provider-native account data, separate from ChatGPT subscription quotas.",
  "properties": {
    "balances": {
      "items": {
        "$ref": "#/definitions/ProviderBalance"
      },
      "type": "array"
    },
    "limits": {
      "items": {
        "$ref": "#/definitions/ProviderUsageWindow"
      },
      "type": "array"
    }
  },
  "required": [
    "balances",
    "limits"
  ],
  "title": "ProviderAccountStatus",
  "type": "object"
}